# 复制为 .env 后填写真实密钥；.env 已被 Git 忽略，禁止提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 默认直连 DeepSeek；仅在直连失败时填写本机 Clash 混合端口。
DEEPSEEK_PROXY_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 结构化 JSON 输出默认关闭思考，避免思考内容耗尽输出上限而没有最终正文。
# 设为 false 可用于对照实验；不建议在未提高 max_tokens 的情况下关闭此保护。
LLM_JSON_DISABLE_THINKING=true

# 本地 HeartMuLa 生成配置。
HEARTMULA_MODEL_PATH=data/ckpt/HeartMuLaGen
MUSIC_OUTPUT_DIR=data/output/generated
